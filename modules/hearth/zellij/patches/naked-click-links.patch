+            return None;
+        }
+        let pane = tab.get_pane_with_id(active_pane_id)?;
+        if pane.position_is_on_frame(position) {
+            return None;
+        }
+        let relative_position = pane.relative_position(position);
+        if let (Some(link_id), Some(plugin_id)) = (
+            pane.link_anchor_at(&relative_position),
+            pane.first_highlight_plugin_id(),

+    /// Keep the drag-selection autoscroll timer in step with this event.
+    ///
+    /// A held left-drag arms the timer with the current position; anything else
+    /// disarms it. Re-posted ticks come back through here as ordinary motion
+    /// events and simply refresh the held position, so the arm is idempotent.
+    fn track_selection_autoscroll(&mut self, event: &MouseEvent, client_id: ClientId) {
+        let dragging = event.event_type == MouseEventType::Motion && event.left;
+        let selecting = self
+            .get_active_tab(client_id)
+            .map(|tab| tab.selecting_with_mouse_in_pane.is_some())
+            .unwrap_or(false);
+        if dragging && selecting {
+            self.arm_selection_autoscroll(*event, client_id);
+        } else {
+            self.disarm_selection_autoscroll();
+        }
+    }
+
+    /// Start (or refresh) the timer that re-posts a held drag position.
+    ///
+    /// Terminals only report a motion when the cell under the pointer changes,
+    /// so a cursor parked past a pane edge produces no events at all and the
+    /// autoscroll in `TerminalPane::update_selection` never runs — which is why
+    /// selecting a long scrollback used to mean jittering the mouse sideways to
+    /// keep it moving. One thread, shared by every client, re-posts the held
+    /// position on a fixed tick; `update_selection` bills the elapsed time, so
+    /// the speed is the same whether the pointer is parked or being wiggled.
+    fn arm_selection_autoscroll(&mut self, event: MouseEvent, client_id: ClientId) {
+        if let Ok(mut held) = self.selection_autoscroll.lock() {
+            *held = Some((event, client_id));
+        }
+        if self.selection_autoscroll_running.swap(true, Ordering::SeqCst) {
+            // A tick thread is already running and has just been handed the new
+            // position — nothing else to do.
+            return;
+        }
+        let running = self.selection_autoscroll_running.clone();
+        let held = self.selection_autoscroll.clone();
+        let senders = self.bus.senders.clone();
+        let spawned = thread::Builder::new()
+            .name("selection_autoscroll".to_string())
+            .spawn(move || {
+                let mut previous: Option<(MouseEvent, ClientId)> = None;
+                let mut ticks_held_still = 0usize;
+                while running.load(Ordering::SeqCst) {
+                    thread::sleep(Duration::from_millis(SELECTION_AUTOSCROLL_TICK_MS));
+                    if !running.load(Ordering::SeqCst) {
+                        break;
+                    }
+                    let current = match held.lock() {
+                        Ok(held) => *held,
+                        Err(_) => break,
+                    };
+                    let Some((event, client_id)) = current else {
+                        break;
+                    };
+                    // Safety valve: a Release that never arrives (a client that
+                    // dropped mid-drag) would otherwise leave this scrolling
+                    // forever. Moving the mouse resets the count, so a genuine
+                    // long hold is only ever cut off after this much dead still.
+                    if previous == current {
+                        ticks_held_still += 1;
+                        if ticks_held_still > SELECTION_AUTOSCROLL_MAX_STILL_TICKS {
+                            break;
+                        }
+                    } else {
+                        ticks_held_still = 0;
+                        previous = current;
+                    }
+                    if senders
+                        .send_to_screen(ScreenInstruction::MouseEvent(event, client_id, None))
+                        .is_err()
+                    {
+                        break;
+                    }
+                }
+                running.store(false, Ordering::SeqCst);
+            });
+        if spawned.is_err() {
+            log::error!("Failed to spawn the selection autoscroll thread");
+            self.selection_autoscroll_running.store(false, Ordering::SeqCst);
+        }
+    }
+

+                plugin_id,
+                LINK_ANCHOR_PATTERN.to_string(),
+                uri,
+                BTreeMap::new(),
+            ),
+            ArmedLinkClick::Highlight {
+                plugin_id,
+                pattern,
+                matched_string,
+                context,
+            } => (plugin_id, pattern, matched_string, context),
+        };

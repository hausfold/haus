+    /// Why this has to live at the very top of the event path, above
+    /// `determine_mouse_action`: a pane whose application wants the mouse
+    /// (Claude Code, or any TUI) has every unmodified click forwarded straight
+    /// to it, so nothing downstream ever gets to look at what was under the
+    /// pointer. Upstream's answer was Alt+Click — the one gesture zellij keeps
+    /// for itself — but ⌥ can only report the VISIBLE matched text, which is
+    /// wrong for exactly the links an agent prints: hard-wrapped URLs (two
+    /// unrelated strings on two rows) and OSC 8 hyperlinks (the destination
+    /// isn't in the text at all). Meanwhile ⌘ isn't an option for anyone: the
+    /// SGR mouse encoding has bits for shift, alt and ctrl and none for super,
+    /// so a ⌘-click arrives here indistinguishable from a bare one.
+    ///
+    /// So: the bare click is the gesture, the anchor is the source of truth,
+    /// and ⌥ goes back to meaning what upstream means by it (pane grouping).
+    /// ⇧ still bypasses the whole multiplexer into the host terminal, which is
+    /// the escape hatch when a target is one we get wrong.
+    ///
+    /// The shape is a browser's: arm on press, act on release, and only when
+    /// both landed on the same link. While armed, every event is swallowed —
+    /// the application must not see a lone release for a press it never got,
+    /// and a drag that began on a link should select nothing rather than half
+    /// a line. Returning `None` means "not a link click", and the event flows
+    /// on untouched.
+    fn handle_link_click(
+        tab: &mut Tab,
+        event: &MouseEvent,
+        client_id: ClientId,
+    ) -> Result<Option<MouseEffect>> {
+        if !event.left {
+            // Not part of the gesture at all (a wheel notch, the right
+            // button). Left alone rather than disarmed: dropping the arm here
+            // would hand the application a release for a press it never got.
+            return Ok(None);
+        }

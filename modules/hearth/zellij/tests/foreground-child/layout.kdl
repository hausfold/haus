layout {
    cwd "/Users/test"
    tab name="workshop" {
        pane split_direction="vertical" {
            pane command="claude" cwd=".cache/claude-worktrees/workshop/first" {
                args "--resume" "0f44331c-cf37-4558-bcfb-e78d3d88d3f7"
                start_suspended true
            }
            pane command="/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/sourcekit-lsp" cwd=".cache/claude-worktrees/workshop/second" {
                start_suspended true
            }
            pane cwd="code/workshop"
        }
    }
    tab name="perch" focus=true {
        pane command="/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/sourcekit-lsp" cwd=".cache/claude-worktrees/perch/third" {
            start_suspended true
        }
    }
}

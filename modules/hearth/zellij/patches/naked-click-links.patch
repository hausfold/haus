+            // A modified click abandons a click in progress rather than
+            // completing it as something the user didn't ask for. Its RELEASE
+            // is still swallowed if a click was pending, for the same reason
+            // the bare path swallows one: the application never saw the press,
+            // so it must not see the release either.
+            let was_armed = tab.link_click_armed.remove(&client_id).is_some();
+            if was_armed && event.event_type == MouseEventType::Release {
+                return Ok(Some(MouseEffect::state_changed()));
+            }
+            return Ok(None);
+        }
+        match event.event_type {
+            MouseEventType::Press => {
+                let repeat_of_the_last_open = tab
+                    .last_link_click_open
+                    .get(&client_id)
+                    .map(|(at, at_position)| {
+                        at.elapsed() < LINK_CLICK_DEBOUNCE && at_position == &event.position
+                    })
+                    .unwrap_or(false);
+                if repeat_of_the_last_open {
+                    // The second press of a double-click on the same cell: let
+                    // it through as an ordinary click rather than opening the
+                    // link a second time. Keyed on the position as well as the
+                    // clock, so a deliberate click on a DIFFERENT link right
+                    // afterwards still opens.
+                    tab.link_click_armed.remove(&client_id);
+                    return Ok(None);
+                }
+                match Self::link_click_target(tab, &event.position, client_id) {
+                    Some(target) => {
+                        tab.link_click_armed.insert(client_id, target);
+                        Ok(Some(MouseEffect::default()))
+                    },
+                    None => {
+                        tab.link_click_armed.remove(&client_id);
+                        Ok(None)
+                    },
+                }
+            },

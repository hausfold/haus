+/// drag has to be held to scroll without leaving the pane. Also the width of
+/// the brake strip at the opposite edge (see `selection_scroll_zone_depth`).
+/// Keeping a zone inside the pane matters for a fullscreen Ghostty window:
+/// crossing its boundary has no useful extra mouse range to report.
+const SELECTION_SCROLL_EDGE_MARGIN: isize = 3;
+/// A drag has to sweep this many rows before the in-pane zone can arm at all.
+/// Starting near an edge is common for a short, precise selection; it must not
+/// immediately turn into autoscroll.
+const SELECTION_SCROLL_INPANE_MIN_LINES: isize = 3;
+/// Swept fraction of the pane, in percent, at which the scroll zone stops
+/// growing and covers everything but the brake strip. Two thirds of a 37-row
+/// pane is 24 rows: past that, a held drag scrolls from wherever the pointer
+/// is, without going anywhere near the edge.
+const SELECTION_SCROLL_FULL_ARM_PERCENT: isize = 66;
+
+/// How deep into the pane the autoscroll zone reaches, in rows from the edge,
+/// given how many rows the drag has swept so far.
+///
+/// The zone GROWS with the selection. A three-row drag has to be taken to the
+/// last three rows to scroll — precise work stays precise. Once the drag has
+/// swept two thirds of the pane it is unambiguously a long selection, and the
+/// zone covers everything but a brake strip at the far edge, so the scroll
+/// keeps running with the pointer parked comfortably inside the window.
+///
+/// The brake strip is what makes the wide zone livable: pulling the pointer
+/// back to the *opposite* edge is how a long drag stops scrolling without
+/// releasing the button. It can't be "drag back towards the anchor" once the
+/// anchor has scrolled off the top of the pane, which for a long selection it
+/// always has.
+fn selection_scroll_zone_depth(swept_rows: isize, pane_height: isize) -> isize {
+    let full_sweep = (pane_height - 1).max(1);
+    let full_arm = (full_sweep * SELECTION_SCROLL_FULL_ARM_PERCENT / 100)
+        .max(SELECTION_SCROLL_INPANE_MIN_LINES + 1);
+    let widest = (pane_height - SELECTION_SCROLL_EDGE_MARGIN).max(SELECTION_SCROLL_EDGE_MARGIN);
+    if swept_rows >= full_arm {
+        return widest;
+    }
+    let progress = (swept_rows - SELECTION_SCROLL_INPANE_MIN_LINES).max(0);
+    let span = full_arm - SELECTION_SCROLL_INPANE_MIN_LINES;
+    SELECTION_SCROLL_EDGE_MARGIN + (widest - SELECTION_SCROLL_EDGE_MARGIN) * progress / span.max(1)
+}
+
+/// `(f + f²) / 2 * span`, in integers, with `f = num / den` clamped to 1.
+///
+/// Curved rather than linear because the useful resolution is at the slow end:
+/// perceived speed goes roughly with the log of actual speed, so a linear ramp
+/// spends most of its travel on differences you can't feel. A plain square
+/// overshoots the other way — the first cut of this patch used one, and every
+/// everyday gesture sat in a band that read as one flat speed. The mean of the
+/// linear and squared terms keeps the bottom-end resolution while getting the
+/// ramp moving inside the first few rows.
+fn selection_scroll_curve(num: usize, den: usize, span: usize) -> usize {
+    let den = den.max(1);
+    let num = num.min(den);
+    (span / 2) * (num * den + num * num) / (den * den)
+}

+/// zone reaches deep INSIDE the pane for a long selection, that travel is real:
+/// shove the pointer to the edge for ten screenfuls a second, ease it back
+/// towards the middle to crawl.
+fn selection_scroll_rate(
+    swept_rows: usize,
+    depth: usize,
+    zone_depth: usize,
+    pane_height: usize,
+) -> usize {
+    let span = SELECTION_SCROLL_MAX_RATE - SELECTION_SCROLL_MIN_RATE;
+    let full_sweep = pane_height.saturating_sub(1);
+    let ceiling =
+        SELECTION_SCROLL_MIN_RATE + selection_scroll_curve(swept_rows, full_sweep, span);
+    SELECTION_SCROLL_MIN_RATE
+        + selection_scroll_curve(
+            depth,
+            zone_depth.saturating_sub(1),
+            ceiling - SELECTION_SCROLL_MIN_RATE,
+        )
+}

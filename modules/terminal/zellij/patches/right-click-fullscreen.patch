+        // haus: a bare right-click anywhere in a pane (frame or body)
+        // zooms it fullscreen — the same MouseAction::ToggleFullscreen the
+        // Ctrl+Click zoom above already uses, just a different trigger.
+        // Upstream's right-click has nothing standing in the way here: it
+        // only forwards to the pane below (SendToTerminal, in the block this
+        // now precedes), so a right-click TUI context menu (lazygit, vim,
+        // mc, …) loses its own gesture — a real, accepted cost, not an
+        // oversight (see haus.terminal.rightClickFullscreen). Only the Press is
+        // claimed, same as Ctrl+Click: the matching Release has no special
+        // case and falls through to the ordinary block below exactly like a
+        // ctrl+left Release already does, so this isn't a new pattern.
+        let is_right_press = event.right && event.event_type == MouseEventType::Press;
+        if is_right_press {
+            if ctx.pane_id_at_position.is_some() {
+                return Ok(MouseAction::ToggleFullscreen {
+                    position: event.position,
+                });
+            }
+            return Ok(MouseAction::NoAction);
+        }

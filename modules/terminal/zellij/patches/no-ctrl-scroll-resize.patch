--- a/zellij-server/src/tab/mouse_handler.rs
+++ b/zellij-server/src/tab/mouse_handler.rs
@@ -1252,14 +1252,16 @@
 
         if event.wheel_up || event.wheel_down {
             if let Some(pane_id) = ctx.pane_id_at_position {
-                if event.ctrl {
-                    if event.wheel_up {
-                        return Ok(MouseAction::ResizeScrollUp { pane_id });
-                    }
-                    if event.wheel_down {
-                        return Ok(MouseAction::ResizeScrollDown { pane_id });
-                    }
-                }
+                // haus: ctrl+wheel used to resize the pane under the
+                // pointer (MouseAction::ResizeScrollUp/Down). Removed — it is
+                // an accidental gesture, not a chosen one: ctrl is held for
+                // half the shortcuts a terminal app owns, and one wheel notch
+                // while it is down silently reshapes the layout with no undo.
+                // Upstream gates this on nothing at all (advanced_mouse_actions
+                // only covers pane grouping and hover effects), so a patch is
+                // the only way off it. Ctrl+wheel now falls through to plain
+                // scroll, and deliberate resizing stays where it was: the
+                // resize mode keys, and ctrl+drag on a pane frame.
                 if event.wheel_up {
                     return Ok(MouseAction::ScrollUp { pane_id, lines: 3 });
                 }

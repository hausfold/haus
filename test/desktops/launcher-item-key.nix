# A palette item keyed by a bare word. Every real key is an ADDRESS pounce
# dispatches on — `mode:filesearch`, `cmd:emoji`, `app:/Applications/Foo.app` —
# so a plain name reaches no row at all, and the seam has to say which shapes
# it was expecting rather than only that this one was wrong.
{
  haus.launcher.items.filesearch.alias = "ff";
}

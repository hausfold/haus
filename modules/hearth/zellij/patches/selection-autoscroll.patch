+    /// Start (or refresh) the timer that re-posts a held drag position.
+    ///
+    /// Terminals only report a motion when the cell under the pointer changes,
+    /// so a cursor parked past a pane edge produces no events at all and the
+    /// autoscroll in `TerminalPane::update_selection` never runs — which is why
+    /// selecting a long scrollback used to mean jittering the mouse sideways to
+    /// keep it moving. One thread, shared by every client, re-posts the held
+    /// position on a fixed tick; `update_selection` bills the elapsed time, so
+    /// the speed is the same whether the pointer is parked or being wiggled.
+    fn arm_selection_autoscroll(&mut self, event: MouseEvent, client_id: ClientId) {

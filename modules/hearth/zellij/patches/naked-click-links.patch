+// haus: the case no plugin regex can reach — an OSC 8 hyperlink, where
+// the visible text is a word and the destination lives in the escape sequence.
+// The click resolves it from the cell's anchor and reports it under
+// LINK_ANCHOR_PATTERN, which is what makes a hard-wrapped or hidden URL open
+// whole instead of one visible fragment of it.
 #[test]
+fn click_on_osc8_hyperlink_sends_resolved_uri() {
+    let size = Size {
+        cols: 121,
+        rows: 20,
+    };
+    let client_id = 1;
+    let (mut tab, mock_plugin_receiver) =
+        create_new_tab_with_plugin_receiver(size, ModeInfo::default());
+
+    // `see it` is the visible text; the URI is never printed.
+    tab.handle_pty_bytes(
+        1,
+        Vec::from("\u{1b}]8;;https://example.com/a/b\u{1b}\\see it\u{1b}]8;;\u{1b}\\".as_bytes()),
+    )
+    .unwrap();
+
+    // A highlight the click does NOT land on: the anchor path still needs a
+    // plugin to hand the target to, and this is how the pane names one.
+    let highlights = vec![RegexHighlight {
+        pattern: "nothing-matches-this".into(),
+        style: HighlightStyle::Emphasis0,
+        layer: HighlightLayer::Hint,
+        context: BTreeMap::new(),
+        on_hover: false,
+        bold: false,
+        italic: false,
+        underline: true,
+        tooltip_text: None,
+    }];
+    tab.set_plugin_regex_highlights_for_pane(
+        PaneId::Terminal(1),
+        42,
+        highlights,
+        &Style::default(),
+    );
+
+    // Click the middle of "see it" (content starts at row 1, col 1).
+    let click_position = Position::new(1, 3);
+    tab.handle_mouse_event(
+        &MouseEvent::new_left_press_event(click_position),
+        client_id,
+    )
+    .unwrap();
+    tab.handle_mouse_event(
+        &MouseEvent::new_left_release_event(click_position),
+        client_id,
+    )
+    .unwrap();
+
+    let mut clicked = None;
+    while let Ok((instruction, _ctx)) = mock_plugin_receiver.try_recv() {
+        if let PluginInstruction::HighlightClicked {
+            plugin_id,
+            pattern,
+            matched_string,
+            ..
+        } = instruction
+        {
+            clicked = Some((plugin_id, pattern, matched_string));
+        }
+    }
+    assert_eq!(
+        clicked,
+        Some((42, "<link-anchor>".to_string(), "https://example.com/a/b".to_string())),
+        "The anchor's URI should be reported, not the visible text"
+    );
+}

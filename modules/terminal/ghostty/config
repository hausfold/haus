# ONE theme, whichever variant haus.theme.{flavor,contrast} selected —
# terminal drops it at ~/.config/ghostty/themes/nebelung. This used to be
# `dark:nebelung,light:Catppuccin Latte`, i.e. it followed macOS appearance and
# fell back to STOCK Catppuccin in light mode, which meant a Mac running light
# appearance never actually got the Nebelung palette. Now that nebelung renders a
# light variant of its own, the rice's own option decides — and it decides for
# bat, delta, lsd and yazi the same way, none of which can switch on appearance.
# (Following macOS appearance with Nebelung on both sides is the roadmap's
# `theme.scheme = "auto"`; it needs a runtime watcher, not a config line.)
theme = nebelung

font-family = @FONT_FAMILY@
font-size = @FONT_SIZE@

# Auto-attach to (or create) the "main" zellij session on launch.
# Skipped for quick-terminal, for nested ghostty (already inside zellij),
# and when NO_ZELLIJ=1 is set. Falls back to plain zsh if zellij errors.
command = @HOME@/.config/zellij/launch.sh

macos-titlebar-style = hidden
# Kill the window drop-shadow. Under AeroSpace, windows tile edge-to-edge
# and a shadow at every seam reads as clutter; gaps + the nebelung theme already
# separate the tiles, so nothing is lost by dropping it. Purely ghostty's own
# look — this is NOT what keeps the bar clean.
#
# It used to be. This line was originally the workaround for a bottom-docked
# bar being darkened by the shadow of the window above it, and the comment
# claimed the general fix "needs the SIP-off yabai scripting addition" (true of
# yabai's window_shadow — it is a pure scripting-addition payload, no direct
# path — but the wrong problem). The bar was never being shadowed because
# shadows exist; it was being shadowed because SketchyBar draws at
# kCGBackstopMenuLevel, UNDER the windows. bar now lifts a bottom bar to
# kCGFloatingWindowLevel instead — bar_topmost() in modules/bar/default.nix is
# the rule, applied by bar-bottomrc and sketchybarrc — which fixes it for every
# app at once and needs no SIP, no yabai, and nothing from ghostty.
macos-window-shadow = false
# Option is sent into the terminal as Alt, so ⌥-chords reach zellij / the shell
# instead of composing accented characters.
#
# This line used to be described as the thing that leaves ⌘ free to be
# ghostty's link-open modifier, with Opt+Click zellij's link gesture and
# Cmd+Click ghostty's. Half of that was never true: SGR mouse reports encode
# shift, alt and ctrl and have NO bit for super, so a ⌘+Click inside any
# mouse-tracking program (zellij always, an agent TUI on top of it) arrives
# indistinguishable from a bare click and ghostty never gets a say — which is
# exactly why ⌘+Click "did the same thing as a click" in a Claude Code pane.
# Links now open on a BARE click, resolved inside zellij from the cell's link
# anchor (terminal's naked-click-links.patch), and ⌥+Click is not a link gesture
# at all any more.
#
# ghostty still owns SHIFT (see mouse-shift-capture below), so ⌘⇧+Click stays
# the escape hatch into its own opener from any pane — ⇧ frees the mouse from
# the program capturing it, ⌘ is what makes ghostty read a link under the
# pointer at all, and ⌘⇧+hover is what draws its preview. Both halves are
# ghostty's own rule: `link-url` hard-wires the hover condition to cmd and
# ghostty 1.3.1 cannot configure `link` ("TODO: This can't currently be set!").
# It sees embedded links at all only because zellij's config.kdl sets
# `osc8_hyperlinks true` to forward them out. See that block for the full story.
macos-option-as-alt = true

# Shift is the ONE modifier that always reaches ghostty, whatever program owns
# the pane — that is what makes ⌘⇧+Click a dependable way out of the
# multiplexer and into ghostty's own link opener, and ⇧-drag a dependable way
# into its selection. `false` is already the default, but at that setting a
# program can flip it with XTSHIFTESCAPE; `never` is the same rule with the
# override refused, so no application can quietly claim the one gesture the
# whole link design keeps in reserve.
mouse-shift-capture = never

# Make zellij's bottom status bar sit flush along the window's bottom edge at
# EVERY font size. The ghostty window is tiled at a fixed pixel height (windows /
# AeroSpace), so when a font size doesn't divide the height evenly, ghostty
# leaves the leftover pixels as padding on the BOTTOM (and right) edge —
# window-padding-balance defaults to false. That's why the top tab-bar always
# looks flush but the bottom status-bar floats above a background-coloured gap,
# and why only a few zoom levels (font-size 19 out of the box) happen to divide
# evenly. Painting that leftover padding with the nearest grid cell's background
# (the zellij status-bar row) makes the bar bleed its own colour down to the
# window edge, so it reads as flush at any zoom level.
#
# This MUST be `extend-always`, not plain `extend`. `extend` applies heuristics
# that disable extension row-by-row, and the zellij bar row trips two of them:
# it contains powerline separator glyphs () and its right end has default-
# background cells — both of which ghostty's `extend` refuses to paint (it
# assumes powerline ribbons and default-bg gaps look wrong extended). An earlier
# attempt with plain `extend` shipped on the theory that these heuristics only
# apply to primary-screen apps and zellij (alt-screen) is exempt; that was
# wrong — the gap persisted in a fresh ghostty. `extend-always` forces the
# extension unconditionally, ignoring every heuristic, which is exactly what a
# uniform full-width status bar wants.
window-padding-color = extend-always

# extend-always alone still dumps 100% of the non-divisible leftover on the
# BOTTOM edge (balance defaults to false), so at zoom levels where the remainder
# is large the extended status-bar background reads as a fat slab of dead space
# below the last row — "flush" but bottom-heavy. Balancing splits the remainder
# evenly top/bottom (and left/right): the visible bottom band halves, and its
# other half moves to the TOP, where extend-always paints it with the tab-bar
# row's background (the dark terminal bg) so it blends into the surrounding black
# and stays invisible. Worst-case band is thus ~half a cell height, not a full
# one, at every zoom.
window-padding-balance = true

quit-after-last-window-closed = true
window-save-state = never
confirm-close-surface = false

#zellij overwrites
keybind = cmd+t=unbind
keybind = cmd+p=unbind
# cmd+shift+p → zellij "Super Shift p": a new pane that STAYS in the focused
# pane's cwd, even inside an agent worktree (the no-hop sibling of cmd+p).
# Ghostty binds cmd+shift+p to its command palette by default — unbind it so the
# chord reaches zellij instead of popping the palette.
keybind = cmd+shift+p=unbind
keybind = cmd+y=unbind
keybind = cmd+shift+y=unbind
keybind = cmd+shift+t=unbind
# cmd+f → zellij "Super f": FIND — full-text search over this pane (find.sh).
# Ghostty binds cmd+f to its native-macOS window fullscreen by default, so this
# unbind is what lets ⌘F mean here what it means in every other app on the
# machine. (Pane fullscreen used to live on this chord; it moved to cmd+enter.)
keybind = cmd+f=unbind
# cmd+shift+f → zellij "Super Shift f": the same find overlay, opened across
# every pane in the session instead of just the focused one. Ghostty binds
# nothing here today; unbind it defensively so the chord keeps reaching zellij.
keybind = cmd+shift+f=unbind
@GH_DASH_GHOSTTY_BIND@
# cmd+enter → zellij "Super Enter" (toggle the focused pane fullscreen), which
# is where pane zoom moved when ⌘F went back to meaning find. Ghostty binds
# nothing here today; unbind it defensively, same as cmd+shift+a, so a future
# release can't claim the chord out from under the multiplexer.
keybind = cmd+enter=unbind
# cmd+a → zellij "Super a" (spawn an isolated AGENT in its own worktree).
# Ghostty binds cmd+a to select_all by default — unbind it so the chord reaches
# zellij. (The agent lived on ⌘C until it was rebound to ⌘A for "agent", which
# also let ⌘C go back to meaning copy — see the cmd+c line below.)
keybind = cmd+a=unbind
@BENCH_LANE_GHOSTTY_BIND@
# cmd+shift+a → zellij "Super Shift a" (the same isolated agent, but replacing
# the focused pane instead of splitting beside it). Ghostty binds nothing here
# today, so this unbind is purely defensive: it guarantees the chord keeps
# reaching zellij if a future ghostty release claims it.
keybind = cmd+shift+a=unbind
# cmd+c → ghostty's own copy, deliberately. This chord (and cmd+shift+c) used to
# be unbound so they'd reach zellij as the agent-spawn binds; those moved to
# ⌘A / ⇧⌘A ("a" for agent), which frees ⌘C to mean here what it means in every
# other app on the machine. Bound explicitly rather than left to ghostty's
# default, so the intent sits on the page beside the unbinds and no future
# default change can take it away. The everyday copy path is still zellij's own
# — a mouse selection is piped through copy_command (copy-clean.pl) on release;
# ⌘C is the ghostty-level fallback, for a ghostty-level (⇧-drag) selection.
# cmd+shift+c is simply released back to ghostty, which binds nothing to it.
keybind = cmd+c=copy_to_clipboard
# cmd+l → zellij "Super l": open Pounce Links command for the focused pane.
keybind = cmd+l=unbind
# cmd+r → still released to the program (`unbind` is passthrough, not `ignore`),
# but nothing catches it any more. It used to reach zellij's "Super r"
# session-reload chord; that chord is gone, because a rebuild's config.kdl now
# hot-reloads into the running server (terminal's zellijLiveConfig). Kept as an
# explicit unbind rather than handed back to Ghostty's default: ⌘R reads as
# "reload" to muscle memory, and a Ghostty-level binding would act on the
# surface zellij is driving. Same spelling and same reasoning as cmd+d below.
keybind = cmd+r=unbind
# cmd+w → zellij "Super w": close the focused PANE. Ghostty's default here is
# close_surface, and since confirm-close-surface = false above, that default made
# ⌘W a silent one-key kill of the entire window — the zellij client with it —
# from any pane, at any time. Handing the chord to the multiplexer both fixes
# that and gives panes the one-chord exit they never had. cmd+shift+w is
# deliberately NOT unbound: it stays ghostty's close_window, so the "close the
# real window" action keeps a key of its own, one shift away from the pane one.
keybind = cmd+w=unbind
# cmd+d / cmd+shift+d → nothing at all, deliberately. Ghostty's defaults here
# are new_split:right and new_split:down — GHOSTTY splits, invisible to zellij:
# they nest a second terminal surface INSIDE the one zellij is driving, so the
# multiplexer's layout, status bar and pane binds end up applying to only half
# the window. It looks like a split and quietly breaks the session's model, and
# it's an easy chord to hit by accident (⌘d is muscle memory from iTerm/other
# terminals). No zellij bind is added in its place: the point is that the keys
# do nothing, not that they do something else.
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
# ghostty binds ctrl+tab to its own next_tab/previous_tab by default, and
# even unbound, macOS AppKit swallows ctrl+tab for focus navigation before
# the terminal core sees it. So bind it to SEND the kitty-keyboard-protocol
# encoding explicitly (CSI 9;5u / 9;6u = ctrl+Tab / ctrl+shift+Tab); zellij's
# config.kdl binds those to the tab-history plugin (MRU back/forward).
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u

macos-icon-frame = chrome
macos-icon-ghost-color = 333333
macos-icon-screen-color = 404040

macos-icon = custom-style

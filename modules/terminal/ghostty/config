# ONE theme, whichever variant haus.theme.{flavor,contrast} selected —
# terminal drops it at ~/.config/ghostty/themes/nebelung. This used to be
# `dark:nebelung,light:Catppuccin Latte`, i.e. it followed macOS appearance and
# fell back to STOCK Catppuccin in light mode, which meant a Mac running light
# appearance never actually got the Nebelung palette. Now that nebelung renders a
# light variant of its own, the rice's own option decides — and it decides for
# bat, delta, lsd and yazi the same way, none of which can switch on appearance.
# (Following macOS appearance with Nebelung on both sides is the roadmap's
# `theme.scheme = "auto"`; it needs a runtime watcher, not a config line.)
theme = nebelung

font-family = @FONT_FAMILY@
font-size = @FONT_SIZE@

# Attach to (or create) this window's own zmx session on launch — `term.<n>`,
# lowest n no session holds, so a new window is always a new shell. Putting the
# PARKED ones back is the same script's other job, done once for the first
# window of a Ghostty (haus.terminal.restoreWindows).
# Skipped for quick-terminal, for a nested surface (already in a session) and
# when HAUS_NO_ZMX=1 is set. Falls back to plain zsh if zmx errors.
#
# There is no "main" session any more, because there is no multiplexer for one
# to belong to: a window IS a pane now. The session exists per window, and it
# exists at all because Ghostty's AppleScript API can create a surface but
# cannot READ one — ⌘F, ⌘L and the bar's peek all need `zmx history`.
command = @HOME@/.config/haus/term/launch.sh

macos-titlebar-style = hidden
# Kill the window drop-shadow. Under AeroSpace, windows tile edge-to-edge
# and a shadow at every seam reads as clutter; gaps + the nebelung theme already
# separate the tiles, so nothing is lost by dropping it. Purely ghostty's own
# look — this is NOT what keeps the bar clean.
#
# It used to be. This line was originally the workaround for a bottom-docked
# bar being darkened by the shadow of the window above it, and the comment
# claimed the general fix "needs the SIP-off yabai scripting addition" (true of
# yabai's window_shadow — it is a pure scripting-addition payload, no direct
# path — but the wrong problem). The bar was never being shadowed because
# shadows exist; it was being shadowed because SketchyBar draws at
# kCGBackstopMenuLevel, UNDER the windows. bar now lifts a bottom bar to
# kCGFloatingWindowLevel instead — bar_topmost() in modules/bar/default.nix is
# the rule, applied by bar-bottomrc and sketchybarrc — which fixes it for every
# app at once and needs no SIP, no yabai, and nothing from ghostty.
macos-window-shadow = false
# Option is sent into the terminal as Alt, so ⌥-chords reach the shell instead
# of composing accented characters.
#
# ⌘+Click is ghostty's link opener, and ⌘+hover is what draws the preview —
# from any window, whatever program has claimed the mouse. Both halves are
# ghostty's own rule: `link-url` hard-wires the hover condition to cmd, and
# ghostty 1.3.1 cannot configure `link` ("TODO: This can't currently be set!").
# NO SHIFT. ⌘ alone is the gesture; ⇧ is for selection (see mouse-shift-capture
# below) and adding it to a link click buys nothing.
#
# Why ⌘ reaches ghostty at all inside a mouse-tracking agent TUI: ghostty
# CONSUMES a cmd-click as a link click rather than forwarding it. That it
# couldn't forward it is also true — SGR mouse reports encode shift, alt and
# ctrl and have no bit for super — but that fact is about what the program
# would see, not about whether ghostty acts first, and reading it the other way
# is what put a phantom ⇧ in this comment (and on the cheatsheet, and in
# default.nix's patch epitaph) until 2026-08-20. What the missing super bit
# really costs is the OTHER direction: a program can never distinguish ⌘+Click
# from a bare click, so it can't opt out — which is fine, because ghostty never
# hands it over. Under zellij a patch of ours resolved links from the cell's own
# anchor on a NAKED click; with the multiplexer gone a bare click belongs to
# whatever program owns the window, and ⌘ is what asks ghostty for the link.
macos-option-as-alt = true

# Shift is the ONE modifier that always reaches ghostty, whatever program owns
# the window — that is what makes ⇧-drag a dependable way into ghostty's own
# selection over any TUI's mouse grab. `false` is already the default, but at
# that setting a program can flip it with XTSHIFTESCAPE; `never` is the same
# rule with the override refused, so no application can quietly claim the one
# gesture the copy story depends on. (It is NOT what makes the link opener
# work — that is ⌘ alone, above.)
mouse-shift-capture = never

# No progress bar across the top of the window. Agent CLIs (Claude Code among
# them) report task progress via ConEmu's OSC 9;4, and ghostty 1.3.1+ renders
# it as a bar over the window's top edge — in the agent flow that's a strobe
# on every response, in every window at once. The sequence is silently
# ignored instead; the agent panes carry their own status.
progress-style = false

# Split the non-divisible leftover evenly instead of dumping all of it on the
# bottom edge. The ghostty window is tiled at a fixed pixel height (windows /
# AeroSpace), so when a font size doesn't divide that height evenly ghostty has
# leftover pixels to put somewhere, and `false` (the default) puts every one of
# them at the bottom — a fat band of dead space below the last row at most zoom
# levels. Balanced, the worst case is half a cell at the top and half at the
# bottom, both painted in the theme background, both invisible.
#
# `window-padding-color = extend-always` used to sit above this line, and it is
# gone with the multiplexer: it existed to make zellij's bottom status row bleed
# its own colour down to the window edge, and there is no status row now. The
# default (`background`) is what a window with no bar wants.
window-padding-balance = true

quit-after-last-window-closed = true
window-save-state = never
confirm-close-surface = false

# ── the chord layer ──────────────────────────────────────────────────────────
# Every line below used to be an `unbind` whose only job was to let a chord fall
# THROUGH Ghostty to zellij. There is no multiplexer to fall through to now, so
# each one is either a real Ghostty action, a deliberate hole, or a chord that
# pounce's Ghostty-scoped event tap consumes before Ghostty ever sees it
# (modules/launcher's appHotkeys — the same tap that already owns ⌘N and ⌘↵).
#
# `unbind` is passthrough, not `ignore`: the key still reaches the program in
# the window. That is what an unbind is FOR here — pounce's tap sits above
# Ghostty, so a chord it consumes never arrives, and a chord it doesn't consume
# should reach the shell rather than do something Ghostty made up.

# ⌘T — consumed by pounce (cmd:shell-plain): a NEUTRAL terminal, home directory
# and no repo, on the base workspace rather than on the lane page you were
# standing on. It is the escape hatch from the page ownership ⌘N and ⌘↵ obey.
#
# The unbind is still what makes that possible, and for the reason it always
# had: no tabs. A window is a pane in this desktop (windows/AeroSpace tiles
# them), and a Ghostty tab would nest a second layout model inside one tile — so
# the chord every Mac terminal spells "new terminal" was free for the thing that
# actually opens one here.
keybind = cmd+t=unbind
# ⌘⇧T likewise: it was "new tab at this pane's cwd", which is what ⌘N means now.
keybind = cmd+shift+t=unbind

# ⌘N / ⌘⇧N — consumed by pounce (cmd:shell-here[-stay]): a shell WINDOW in the
# focused window's directory, hopping out of an agent worktree unless the
# shifted key says stay. Unbound here so a machine with the agent clients off
# gets a dead key rather than Ghostty's own new_window, which knows nothing
# about "here" and would silently disagree with the cheatsheet.
keybind = cmd+n=unbind
keybind = cmd+shift+n=unbind

# ⌘F / ⌘⇧F — consumed by pounce (cmd:find[-all]): full-text search over this
# window's zmx scrollback, or over every session at once. Ghostty binds cmd+f to
# native-macOS window fullscreen by default, so this unbind is also what stops
# ⌘F meaning something else entirely on a machine without the tap.
keybind = cmd+f=unbind
keybind = cmd+shift+f=unbind

# ⌘Y / ⌘⇧Y — consumed by pounce (cmd:peek[-stay]): the yazi file peek, in a new
# window rather than the tab it used to open.
keybind = cmd+y=unbind
keybind = cmd+shift+y=unbind

# ⌘L — consumed by pounce (cmd:links): every URL this window's scrollback has
# seen, newest first.
keybind = cmd+l=unbind
@GH_DASH_GHOSTTY_BIND@
# ⌘↵ — the LANE chord, consumed by pounce (cmd:lane-here): a new agent lane in
# this window's repo. It was ⌃⌘A in AeroSpace until 2026-08-18. Ghostty binds
# nothing here today; the unbind stays defensive, so a future release can't
# claim the chord out from under pounce.
keybind = cmd+enter=unbind
# ⌘A is NOT unbound and never was — the lane chord is ⌘↵, one layer above.
# ⌘A stays select_all.
@BENCH_LANE_GHOSTTY_BIND@
# ⌘C → ghostty's own copy. Bound explicitly rather than left to the default so
# the intent sits on the page and no future default change can take it away.
# Under zellij this was the FALLBACK path — the everyday copy was a mouse
# selection piped through zellij's copy_command (copy-clean.pl, which stripped
# wrapped-line padding). Ghostty has no copy hook, so that filter is gone
# rather than ported, and ⌘C over a ghostty selection is the whole copy story.
# cmd+shift+c is simply released back to ghostty, which binds nothing to it.
keybind = cmd+c=copy_to_clipboard
# ⌘R — released to the program. It used to reach zellij's session-reload chord;
# nothing catches it now. Kept as an explicit unbind rather than handed back to
# Ghostty's default: ⌘R reads as "reload" to muscle memory, and a Ghostty-level
# binding would act on the surface an agent is drawing into.
keybind = cmd+r=unbind
# ⌘⇧R — Ghostty's own `reset` action, and one of the only chords on this page
# that is Ghostty's rather than pounce's: `reset` is a native action, so unlike
# every chord that has to shell out it has somewhere to live here. It is the
# EMULATOR half of the repair the `reset` shell function does — it fixes the
# surface (alt screen, charset, mouse reporting, a cursor a dead TUI hid) and
# leaves the pty's termios alone, which is exactly the half you need when the
# shell is too wedged to run a command at all. Typing `reset` blind into the
# readable screen it gives you back finishes the job.
#
# It sits on ⇧ + the chord above deliberately: ⌘R stays released to the program
# because it reads as "reload", and every browser on this Mac spells "reload
# harder, from scratch" ⌘⇧R — which is what a reset is. The near-miss is worth
# knowing: reaching for ⌘R and catching ⇧ resets the surface an agent is
# drawing into. It costs a redraw and nothing else — the scrollback is zmx's,
# not the surface's — which is why the mnemonic wins over the extra modifier.
# Free everywhere: Ghostty binds nothing here by default (its only `r` is
# ⌘0 reset_font_size), nor does pounce's appHotkeys, haus.launcher.items,
# modules/lib/keys.nix, AeroSpace, or any macOS symbolic hotkey — there is no
# entry on keycode 15 at all.
keybind = cmd+shift+r=reset
# ⌘W → ghostty's close_window, its own default, restored. Under zellij this was
# unbound so the chord could close the focused PANE instead of silently killing
# the whole client. A window is the pane now, and closing it DETACHES its zmx
# session rather than ending it — the shell keeps running, and the next Ghostty
# start opens a window back onto it — so the destructive edge the unbind existed
# to blunt is gone. NOT the next ⌘N, which is always a new shell: a parked
# session is a live shell in a directory of its own, and handing one to the
# chord that means "a shell here" is how ⌘N used to become a lottery.
# cmd+shift+w stays ghostty's close_window too.
# ⌘D / ⌘⇧D → nothing at all, deliberately. Ghostty's defaults here are
# new_split:right and new_split:down, and splits are unused in this desktop for
# the same reason tabs are: AeroSpace already tiles, and a split nests a second
# layout model inside one tile. It's an easy chord to hit by accident (muscle
# memory from iTerm), so the keys do nothing rather than something else.
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
# ghostty binds ctrl+tab to its own next_tab/previous_tab by default, and even
# unbound, macOS AppKit swallows ctrl+tab for focus navigation before the
# terminal core sees it. So bind it to SEND the kitty-keyboard-protocol encoding
# explicitly (CSI 9;5u / 9;6u = ctrl+Tab / ctrl+shift+Tab), which is what a TUI
# in the window would want. With lanes on the chord never reaches ghostty at
# all: pounce's Ghostty-scoped tap consumes it first and walks the T/* lane
# PAGES by recency instead — the same swallowed-by-AppKit fact is why that walk
# has to live in pounce's event tap rather than in AeroSpace's bindings.
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u

macos-icon-frame = chrome
macos-icon-ghost-color = 333333
macos-icon-screen-color = 404040

macos-icon = custom-style

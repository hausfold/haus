[
  {
    "items": [
      {
        "action": "Tiles layout",
        "binds": {
          "alt-slash": "layout tiles horizontal vertical"
        },
        "keys": "⌥ /"
      },
      {
        "action": "Accordion layout",
        "binds": {
          "alt-comma": "layout accordion horizontal vertical"
        },
        "keys": "⌥ ,"
      },
      {
        "action": "Fullscreen toggle",
        "binds": {
          "alt-f": [
            "fullscreen",
            "exec-and-forget @HOME@/.config/sketchybar/aerospace-notify.sh fullscreen"
          ]
        },
        "keys": "⌥ f"
      },
      {
        "action": "Move workspace to next monitor",
        "binds": {
          "alt-shift-tab": "move-workspace-to-monitor --wrap-around next"
        },
        "keys": "⌥ ⇧ ⇥"
      }
    ],
    "title": "Window Management"
  },
  {
    "items": [
      {
        "action": "Flatten tree",
        "binds": {
          "r": [
            "flatten-workspace-tree",
            "mode main"
          ]
        },
        "keys": "r"
      },
      {
        "action": "Toggle floating",
        "binds": {
          "f": [
            "layout floating tiling",
            "mode main"
          ]
        },
        "keys": "f"
      },
      {
        "action": "Close others",
        "binds": {
          "backspace": [
            "close-all-windows-but-current",
            "mode main"
          ]
        },
        "keys": "⌫"
      },
      {
        "action": "Join with",
        "binds": {
          "alt-shift-down": [
            "join-with down",
            "mode main"
          ],
          "alt-shift-left": [
            "join-with left",
            "mode main"
          ],
          "alt-shift-right": [
            "join-with right",
            "mode main"
          ],
          "alt-shift-up": [
            "join-with up",
            "mode main"
          ]
        },
        "keys": "⌥ ⇧ ←↓↑→"
      },
      {
        "action": "Volume up / down",
        "binds": {
          "down": "volume down",
          "up": "volume up"
        },
        "keys": "↑ / ↓"
      },
      {
        "action": "Mute volume",
        "binds": {
          "shift-down": [
            "volume set 0",
            "mode main"
          ]
        },
        "keys": "⇧ ↓"
      },
      {
        "action": "Reload config + exit",
        "binds": {
          "esc": [
            "reload-config",
            "mode main"
          ]
        },
        "keys": "⎋"
      }
    ],
    "mode": "service",
    "title": "Service Mode [⌥ ⇧ ;]"
  },
  {
    "items": [
      {
        "action": "Command Palette",
        "keys": "⌘ Space"
      }
    ],
    "title": "System"
  }
]

default_layout "custom"
// Startup input mode — baked from nebelhaus.hearth.zellijStartLocked (hearth
// fills the placeholder below with "locked" or "normal"). Locked keeps the
// submode leaders inert until Ctrl-g; the Super launchers (bound in `shared`)
// still fire.
default_mode "@DEFAULT_MODE@"
pane_frames false
scroll_buffer_size 50000
serialize_pane_viewport true
// Clean up grid-selections before they hit the clipboard: dedent the message
// gutter and rejoin hard-wrapped prose, while leaving code/lists/tables intact.
// (Script pipes the cleaned text to pbcopy itself.) See copy-clean.pl.
copy_command "@HOME@/.config/zellij/copy-clean.pl"
show_release_notes false
show_startup_tips false
// Nebelung (Catppuccin with the blue muted out) — the theme block lives in
// ~/.config/zellij/themes/nebelung.kdl, dropped there by home-manager from the
// nebelung flake. Keep this name in sync with that block's name. The zellij port
// is one of the few whose filename does NOT carry the catppuccin flavor, so this
// line needs no change when nebelhaus.theme.flavor does — the file behind it is
// re-rendered light or dark.
theme "nebelung"

// ── Clickable links: Cmd+Click, ghostty's own opener ─────────────────────────
// Cmd+Click → ghostty's own link opener (ghostty/config, `link-url` default).
//   It opens visible `https://` URLs AND — the reason this block exists — OSC
//   8 hyperlinks: links where the visible text is a word and the URL is
//   hidden in the escape sequence (Claude Code /tui's session/PR links are
//   all like this).
//
// osc8_hyperlinks is what makes the OSC 8 half work: it tells zellij to
// FORWARD inner apps' OSC 8 sequences out to ghostty. Default is false, i.e.
// zellij swallows them — which is exactly why embedded links used to open on
// neither click. With it true, ghostty sees them and Cmd+Click resolves them.
//
// There used to be a second layer here — Opt+Click via a `link-handler`
// plugin fork, regex-scanning visible text for paths/schemeless domains. It
// was flaky in practice and redundant with this one, so it's gone; Cmd+Click
// is now the only click-to-open modifier. Declaring load_plugins below still
// REPLACES the default config's list (which auto-loads "zellij:link"), so
// this empty-of-link-plugins block also disables that built-in.
osc8_hyperlinks true

load_plugins {
    // tab-history — Ctrl(+Shift)+Tab walk tabs in most-recently-used order
    // (browser-style back/forward) instead of by position. Loaded here as a
    // background plugin so it records focus history from session start; the
    // Ctrl Tab / Ctrl Shift Tab binds below MessagePlugin "back"/"forward" to
    // it. Its grants are pre-seeded into zellij's permission cache by hearth.
    // See zellij/tab-history/src/main.rs.
    "file:~/.config/zellij/plugins/tab-history.wasm"
}

keybinds {
    shared {
        // Super a — spawn an ISOLATED agent in its own checkout, so parallel
        // agents never move this checkout's branch out from under each other.
        // Merge/inspect their branches from the main checkout; `bench status`
        // lists them. Cmd a reaches zellij as Super a because ghostty/config
        // unbinds cmd+a (its select_all); the status-bar fork renders the
        // "Super + a" hint next to pane/tab in the bottom-right (it resolves the
        // key from whichever spelling below is live).
        //
        // "a" for AGENT, not "c" for Claude: this whole family used to live on
        // ⌘C, from back when Claude Code was the only client it could start. It
        // now starts whichever client nebelhaus.agents.default names, and ⌘C is
        // back to being copy in ghostty (see hearth's ghostty/config).
        //
        // @AGENT_NEW@ is rendered by hearth from nebelhaus.agents.default:
        //   claude   → `claude --worktree`, its NATIVE flag, which fires the
        //              `wt` WorktreeCreate hook in ~/.claude/settings.json.
        //   codex,   → `holt new`: no client-side equivalent exists, so Holt
        //   opencode   makes the same worktree from the outside and opens the
        //              configured client. Holt reads its persisted config, not
        //              Zellij's launch-time environment, so it keeps following
        //              nebelhaus.agents.default after a rebuild.
        //              in it. Same path, branch, registry, parking and reaping.
        // Either way the checkout is ~/.cache/claude-worktrees/<repo>/<name> on
        // branch worktree-<name>, branched from this checkout's local HEAD.
        //
        // No --dangerously-skip-permissions here: hearth pins
        // permissions.defaultMode = "auto" in ~/.claude/settings.json (the
        // claudeCodePermissionMode activation), so agents run unattended with
        // background safety checks rather than the old blanket bypass.
        bind "Super a" { Run @AGENT_NEW@; }
        // Super Shift a — the same isolated agent, but IN PLACE of the focused
        // pane instead of splitting beside it: for when the tab is already as
        // subdivided as you want it and this pane's job is done. Zellij
        // *suppresses* the replaced pane rather than killing it (same mechanism
        // as opening scrollback in an editor), so nothing is lost — when the
        // agent exits, close_on_exit drops its pane and the original shell
        // comes back exactly where it was, scrollback intact. cwd is inherited
        // from the pane being replaced, same as Super a. Reaches zellij with no
        // ghostty change needed (ghostty binds nothing to cmd+shift+a), but
        // ghostty/config unbinds it anyway so a future default can't steal it.
        bind "Super Shift a" {
            Run @AGENT_NEW@ {
                in_place true
                close_on_exit true
            }
        }
        // Ctrl Alt Shift a — the resident agent: works IN this checkout, on
        // whatever branch you're looking at. At most one per tab, by
        // convention — it's the only agent allowed to touch the real tree.
        // @AGENT_HERE@ is nebelhaus.agents.default's client, plain.
        bind "Ctrl Alt Shift a" { Run @AGENT_HERE@; }
        // Super p — New pane, inheriting the focused pane's cwd — except next
        //            to a claude --worktree pane: hearth's zshrc notices a
        //            fresh shell starting inside ~/.cache/claude-worktrees and
        //            hops it to the repo's main checkout instead (the agent's
        //            throwaway dir is no place for a human shell).
        bind "Super p" { NewPane; }
        // Super Shift p — New pane that STAYS in the focused pane's cwd, hop and
        //            all suppressed: the no-hop sibling of Super p, for when you
        //            DO want a shell inside an agent's worktree checkout. Runs
        //            the login shell with ZJ_STAY=1 set, which hearth's zshrc
        //            reads to skip the ~/.cache/claude-worktrees → main-checkout
        //            hop (see modules/hearth default.nix). Reaches zellij because
        //            ghostty/config unbinds cmd+shift+p (its command palette).
        bind "Super Shift p" { Run "sh" "-c" "ZJ_STAY=1 exec \"$SHELL\""; }

        // Super l — Links: open Pounce Links command for the focused pane's
        //            transcript/scrollback.
        bind "Super l" {
            Run "pounce" "run" "cmd:links" {
                floating true
                close_on_exit true
                name "links"
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }

        // Super Enter — toggle the focused pane fullscreen. Zoom one pane to
        //            fill the tab, hit it again to drop back into the tiled
        //            layout. This used to live on Super f; it moved so that
        //            ⌘F could go back to meaning *find* like it does in every
        //            other app on the machine. ⌘⏎ is the zoom key in every
        //            tiling WM worth the name (and prowl's own ⌥F is
        //            untouched), so the muscle memory already exists.
        bind "Super Enter" { ToggleFocusFullscreen; }

        // Super f       — Find in this pane.
        // Super Shift f — Find across every pane in the session.
        //
        // Both open the SAME overlay; the shifted key just enters at session
        // scope, and Ctrl-s toggles scope from inside without a rebuild. The
        // find/find-all pair reads like every Mac app's (⌘F here, ⇧⌘F wider),
        // which is the shape this machine already teaches.
        //
        // Why not `SwitchToMode "EnterSearch"`: hearth renders Claude Code in
        // the alt-screen (`tui = "fullscreen"`), and the alt-screen has no
        // scrollback — so zellij's native search inside an agent pane can only
        // ever see the one screenful on display. find.sh reads those panes'
        // TRANSCRIPTS instead (the same statusline-maintained pane → transcript
        // map the Links bind uses) and falls back to `dump-screen --full` for
        // everything else. The full reasoning is in find.sh's header.
        //
        // Launched as a throwaway 1% corner float, which reads back the pane
        // you meant and then opens the real overlay as a SECOND pane: a bind
        // can only Run something, running it takes focus, and `list-clients`
        // reports only the floating pane when one is focused (zellij#4067), so
        // the target has to come from `list-panes` instead. Nothing may be
        // detached from the launcher — zellij tears down a close_on_exit pane's
        // whole process group — so the overlay has to be a pane of its own
        // (find.sh's header has the full autopsy). Same shape as the Links
        // bind, where pounce's NSPanel gets that for free.
        //
        // That overlay is a BORDERLESS, full-window float: zellij frames every
        // floating pane regardless of `pane_frames false` above, and that frame
        // — green, PIN hint, titled "find" — used to sit around fzf's own
        // border, which said "find" a second time.
        bind "Super f" {
            Run "@HOME@/.config/zellij/find.sh" "launch" "pane" {
                floating true
                close_on_exit true
                name "find-launch"
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }
        bind "Super Shift f" {
            Run "@HOME@/.config/zellij/find.sh" "launch" "session" {
                floating true
                close_on_exit true
                name "find-launch"
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }

        // Super r — reload this zellij session through a fresh server so a
        //            rebuild's config, layout and plugin wasm take effect. The
        //            helper dumps the current tabs/panes/cwds, proves every
        //            command pane's identity, rewrites each Claude pane to
        //            resume its exact conversation, then hands
        //            the destructive half to a launchd-owned process outside
        //            the terminal. That process quits/reopens Ghostty and the
        //            fresh launch.sh recreates the session. The tiny off-screen
        //            float is removed from the dumped layout.
        bind "Super r" {
            Run "@ZRELOAD@" {
                floating true
                close_on_exit true
                name "zreload-helper"
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }

        // yazi as a floating overlay — appears on top of the tiled claude panes,
        // dismissed with q, leaving the tiled layout untouched.
        //
        // Super y  — Peek: file browser rooted at the focused pane's cwd — but
        //            next to a claude --worktree pane it opens at the repo's
        //            MAIN checkout instead, the same hop Super p does (the
        //            agent's throwaway dir is no place to go browsing). The
        //            panel covers the summoning terminal window exactly, so it
        //            reads as that window switching modes. Live markdown/code
        //            preview; Enter on a FILE pages it fullscreen, Enter on a
        //            DIRECTORY opens a new zellij tab cwd'd there (the old
        //            Super-Shift-t picker, now folded in — l/→ still descends
        //            to browse). See peek.sh / peek-run.sh + the peek-open yazi
        //            plugin.
        bind "Super y" {
            Run "@HOME@/.config/zellij/peek.sh" {
                floating true
                close_on_exit true
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }
        // Super Shift y — Peek that STAYS in the focused pane's cwd, hop and all
        //            suppressed: the no-hop sibling of Super y, for when you DO
        //            want to browse an agent's worktree checkout. Exactly the
        //            Super p / Super Shift p relationship, one letter over.
        //            Reaches zellij because ghostty/config unbinds cmd+shift+y.
        bind "Super Shift y" {
            Run "@HOME@/.config/zellij/peek.sh" "--stay" {
                floating true
                close_on_exit true
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }
        // Super t — New tab at $HOME, wherever the focused pane lives: the
        //            plain "give me a fresh tab" bind. Tab-level cwd is the only
        //            form zellij honors under a custom default_tab_template, so
        //            this opens home.kdl (custom.kdl with the content tab pinned
        //            cwd=$HOME, rendered next to it by hearth). It's this NewTab
        //            action the status-bar fork surfaces as the `t` in the
        //            "⌘ + <a,f,l,p,t,y,⏎>" hint block.
        bind "Super t" { NewTab { layout "@HOME@/.config/zellij/layouts/home.kdl"; }; }
        // Super Shift t — New tab cwd'd at the FOCUSED pane's directory (the
        //            "open a tab right here" sibling of Super t's "…at home").
        //            Runs new-tab-here.sh as a throwaway 1%-corner floating pane,
        //            which inherits the focused pane's cwd as $PWD, then clones
        //            the active layout with a tab-level cwd injected (a bare
        //            `new-tab --cwd` is ignored under the custom
        //            default_tab_template — the same layout trick peek-run.sh
        //            uses). Reaches zellij because ghostty/config unbinds
        //            cmd+shift+t.
        bind "Super Shift t" {
            Run "@HOME@/.config/zellij/new-tab-here.sh" {
                floating true
                close_on_exit true
                name "new-tab"
                x "100%"; y "100%"; width "1%"; height "1%"
            }
        }
        // Ctrl (Shift) Tab — walk tabs in most-recently-used order via the
        // tab-history plugin (see load_plugins above), NOT by position:
        // Ctrl Tab goes "back" toward older/previously-focused tabs, Ctrl
        // Shift Tab goes "forward" back toward where you came from — like a
        // browser's history. Repeated presses within ~1.5s walk a frozen
        // snapshot back and forth; after ~1.5s of stillness the tab you
        // landed on commits as the new "current" node. Works in any mode.
        // Only works at all because ghostty/config explicitly sends the
        // kitty-protocol encoding for these (macOS AppKit otherwise swallows
        // ctrl+tab before the terminal sees it). The custom layout's tab-bar
        // shows the "Ctrl+Tab" reminder top-right.
        bind "Ctrl Tab" {
            MessagePlugin "file:~/.config/zellij/plugins/tab-history.wasm" {
                name "back"
            }
        }
        bind "Ctrl Shift Tab" {
            MessagePlugin "file:~/.config/zellij/plugins/tab-history.wasm" {
                name "forward"
            }
        }
    }

    // Alt [ / Alt ] — cycle swap layouts (grid → spiral → columns) while
    // LOCKED too. Upstream binds these in `shared_except "locked"`, so the
    // layout cycle died the moment you locked — yet the tab-bar advertises it
    // top-right, which made the bar look like it was lying. It wasn't: the
    // fork derives that hint from the CURRENT mode's keybinds
    // (tab-bar/src/line.rs, swap_layout_status), so while locked the `Alt <[]>`
    // keys silently dropped off and only the GRID pill remained. Binding them
    // here brings both the action and its hint back, in every mode.
    //
    // These two are safe to steal from the pane's app in a way the rest of the
    // Alt row is NOT: Alt h/j/k/l and Alt arrows are readline/vim word-motion
    // keys, so they stay locked-mode-inert on purpose. Re-picking a layout is a
    // workspace-level act, like Super p / Super t — the same reason those live
    // in `shared`.
    locked {
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
    }

    // ── zellij's NATIVE search, kept and fixed ─────────────────────────────
    // The ⌘F overlay does not replace this. Native search is the only thing
    // that highlights matches IN PLACE and walks them with n/N in the real
    // pane, which is genuinely nicer for a shell pane you're already reading —
    // it just can't see an alt-screen agent pane, which is why the overlay
    // exists alongside it rather than instead of it.
    //
    // Two fixes on top of upstream:
    //   1. `/` enters search from scroll mode, next to upstream's `s`. Nothing
    //      in a terminal means "search" more than `/` (less, vim, man, fzf).
    //   2. Every exit lands on @BASE_MODE@ — this host's default_mode — not
    //      unconditionally on Normal. Upstream's search binds all drop you into
    //      Normal, so on a locked host a single Esc out of a search left the
    //      submode leaders live with nothing on screen saying so. The bar's
    //      mode colour flipped green and that was your only warning.
    scroll {
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" "Esc" { ScrollToBottom; SwitchToMode "@BASE_MODE@"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SearchInput 27; SwitchToMode "@BASE_MODE@"; }
    }
    search {
        bind "Ctrl c" "Esc" { ScrollToBottom; SwitchToMode "@BASE_MODE@"; }
    }

    // Tab-mode n (Ctrl-t n) — zellij's native "new tab", the one tab-creating
    // path that isn't one of our binds/scripts. Route it through home.kdl like
    // Super t so even this tab is born "~" (custom.kdl) instead of "Tab #N";
    // the SwitchToMode mirrors the default bind it shadows.
    tab {
        bind "n" {
            NewTab { layout "@HOME@/.config/zellij/layouts/home.kdl"; }
            SwitchToMode "Normal"
        }
    }
}
